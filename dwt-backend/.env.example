PORT=5000
MONGO_URI=your_mongodb_connection_string
SERVER=http://localhost:5000
JWT_SECRET=your_jwt_secret_key
FRONTEND_URL=http://localhost:5173

# --- Configuration Nodemailer (Emails DWT) ---
# Pour activer l'envoi réel avec Gmail :
# 1. Renseignez votre adresse EMAIL_USER=exemple@gmail.com
# 2. Générez un mot de passe d'application Google dans votre compte (Sécurité -> Mots de passe d'application)
# 3. Renseignez EMAIL_PASS=votre_mot_de_passe_application_16_caracteres
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Dark Wolf Team <no-reply@darkwolfteam.gg>"
ADMIN_EMAIL="admin@darkwolfteam.gg"
NOTIFY_ON_LOGIN=false
