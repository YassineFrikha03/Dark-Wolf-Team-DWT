PORT=5000
MONGO_URI=your_mongodb_connection_string
SERVER=http://localhost:5000
JWT_SECRET=your_jwt_secret_key
FRONTEND_URL=http://localhost:5190

# --- Configuration Nodemailer (Emails DWT) ---
# Pour activer l'envoi réel avec Gmail :
# 1. Renseignez votre adresse EMAIL_USER=exemple@gmail.com
# 2. Générez un mot de passe d'application Google dans votre compte (Sécurité -> Mots de passe d'application)
# 3. Renseignez EMAIL_PASS=votre_mot_de_passe_application_16_caracteres
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Dark Wolf Team <no-reply@darkwolfteam.gg>"
ADMIN_EMAIL="admin@darkwolfteam.gg"
NOTIFY_ON_LOGIN=false

# --- OAuth Google & Discord ---
# Pour Google : console.cloud.google.com -> API & Services
# 1. Configurer l'écran d'autorisation OAuth : Nom de l'app = "Dark Wolf Team"
# 2. Identifiants OAuth -> URI de redirection autorisée : http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Pour Discord : discord.com/developers/applications
# 1. General Information : Name = "Dark Wolf Team"
# 2. OAuth2 -> Redirects : http://localhost:5000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/discord/callback
